[Unit]
Description=Launch one targeted TXT cell replication campaign of 50 simulated outcomes
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/txt
Environment=REACTION_GATED_ORDER_COUNT=50
Environment=REACTION_GATED_MIN_SUCCESS=40
Environment=REACTION_GATED_CAMPAIGN_PREFIX=cellrep50
Environment=REACTION_GATED_STATE_FILE=/opt/txt/logs/reaction_cell_replication_state.json
Environment=REACTION_GATED_LOG=/opt/txt/logs/reaction_cell_replication.log
Environment=REACTION_GATED_VENUES=bybit-public
Environment=REACTION_GATED_TARGET_CLASSES=FAST,SLOW
Environment=REACTION_GATED_TARGET_REGIMES=RANGE
Environment=REACTION_GATED_MATURITY_PREFIXES=rg10-,rg50-,cellrep50-
ExecStart=/usr/bin/python3 /opt/txt/scripts/reaction_gated_campaign10.py