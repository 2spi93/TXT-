/opt/txt/logs/terminal-truth-observer.log /opt/txt/logs/terminal-truth-observer.err.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
    create 0644 root root
}

/opt/txt/logs/terminal-truth-observer.jsonl {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0644 root root
}